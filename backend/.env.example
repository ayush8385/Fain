# Postgres connection string, e.g. postgresql://user:password@localhost:5432/fain
DATABASE_URL=

# Server
PORT=4000

# Google OAuth (Phase 1 — Gmail read-only access)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# LLM extraction fallback (Phase 2) — only one of these needs to be set
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Push notifications (Phase 4)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# Session signing secret (local dev only — generate a new one for prod)
SESSION_JWT_SECRET=
